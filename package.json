    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.19.43",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
